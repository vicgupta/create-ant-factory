# Only needed when worker.provider is "box" (Upstash Boxes).
# Not used by the default Docker provider.
UPSTASH_BOX_API_KEY=

# Fine-grained GitHub token. Resource owner: the account or org that owns
# the factory repo and every app repo. Repository access: factory repo +
# every app repo. Permissions: Contents, Pull requests and Issues,
# all read and write.
FACTORY_GITHUB_TOKEN=

# Claude Code subscription token. The user runs `claude setup-token` in a
# real terminal and pastes the result here. For an API key instead, use
# ANTHROPIC_API_KEY (see references/agents.md). For Codex instead, see
# references/agents.md (CODEX_AUTH_JSON or CODEX_API_KEY).
CLAUDE_CODE_OAUTH_TOKEN=
