{
  "name": "software-factory",
  "version": "0.2",
  "private": true,
  "type": "module",
  "description": "Turns ready GitHub issues into pull requests with coding agents in Upstash Boxes",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "status": "node --env-file=.env scripts/status.mjs",
    "plan": "node --env-file=.env src/plan.mjs",
    "test": "node --test tests/*.test.mjs",
    "report": "node scripts/report.mjs",
    "precedents": "node scripts/precedents.mjs",
    "verify-docker": "node --env-file=.env scripts/verify-docker.mjs",
    "risk-gate": "node scripts/risk-gate.mjs",
    "review-check": "node scripts/review-check.mjs",
    "scheduled-scan": "node scripts/scheduled-scan.mjs"
  },
  "dependencies": {
    "@upstash/box": "^0.7.5"
  }
}
