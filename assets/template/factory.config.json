{
  "factory": {
    "repo": "OWNER/FACTORY-REPO",
    "boxNamePrefix": "factory-",
    "boxLabel": "factory",
    "busyLabel": "busy",
    "branchPrefix": "factory/issue-",
    "gitAuthor": {
      "name": "Software Factory",
      "email": "OWNER@users.noreply.github.com"
    },
    "allowedActors": [
      "OWNER"
    ],
    "browser": true,
    "resumeFromReview": true,
    "planFirst": true,
    "runRecords": true,
    "waitForWorkerMinutes": 20,
    "agentTimeoutMinutes": 25,
    "commandTimeoutMinutes": 15,
    "contextGraph": true,
    "precedentsFile": "precedents.json",
    "riskGates": {
      "maxFilesForReady": 15,
      "maxLinesForReady": 400,
      "noChecks": "draft",
      "failedPrecedent": "draft",
      "rules": [
        {
          "name": "migrations-and-infra",
          "paths": [
            "migrations/",
            "**/migrations/**",
            "infra/",
            "terraform/",
            "**/*.sql"
          ],
          "action": "needs-attention"
        },
        {
          "name": "sensitive-topics",
          "keywords": [
            "auth",
            "billing",
            "payment",
            "secret",
            "password"
          ],
          "action": "draft"
        },
        {
          "name": "critical-service",
          "tiers": [
            "critical"
          ],
          "action": "draft"
        }
      ]
    }
  },
  "worker": {
    "provider": "docker",
    "docker": {
      "image": "create-ant-factory-worker:latest",
      "cpus": "2",
      "memory": "4g"
    }
  },
  "labels": {
    "ready": "ready",
    "running": "factory:running",
    "review": "factory:review",
    "needsAttention": "factory:needs-attention"
  },
  "agents": {
    "claude": {
      "description": "Claude Code signed in with a Claude subscription. The token comes from `claude setup-token`. For an API key see references/agents.md in the skill.",
      "auth": [
        {
          "secret": "CLAUDE_CODE_OAUTH_TOKEN",
          "env": "CLAUDE_CODE_OAUTH_TOKEN"
        }
      ],
      "boxSettings": "ask",
      "command": "claude -p \"$(cat {prompt})\" --dangerously-skip-permissions --output-format text > {summary}"
    },
    "codex": {
      "description": "Codex CLI signed in with a ChatGPT plan. The secret is the content of ~/.codex/auth.json after `codex login`. For an API key see references/agents.md in the skill.",
      "auth": [
        {
          "secret": "CODEX_AUTH_JSON",
          "file": "/workspace/home/.codex/auth.json",
          "localFile": "~/.codex/auth.json"
        }
      ],
      "env": {
        "CODEX_HOME": "/workspace/home/.codex"
      },
      "boxSettings": "ask",
      "command": "codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox --output-last-message {summary} \"$(cat {prompt})\""
    },
    "opencode": {
      "description": "OpenCode signed in with an Anthropic API key. Any models.dev provider works — see references/agents.md in the skill.",
      "auth": [
        {
          "secret": "ANTHROPIC_API_KEY",
          "env": "ANTHROPIC_API_KEY"
        }
      ],
      "boxSettings": "ask",
      "promptExtra": "When you are done, write your summary to the file {summary}, and nothing else to that file.",
      "command": "opencode run --auto \"$(cat {prompt})\" < /dev/null"
    }
  },
  "repos": [
    {
      "repo": "OWNER/APP-REPO",
      "baseBranch": "main",
      "setup": [
        "npm ci"
      ],
      "checks": [
        "npm test",
        "npm run build"
      ],
      "exclude": []
    }
  ],
  "workers": [
    {
      "id": "claude-01",
      "agent": "claude",
      "enabled": true
    },
    {
      "id": "codex-01",
      "agent": "codex",
      "enabled": true
    }
  ]
}
