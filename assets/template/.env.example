# From the Upstash console, Box section.
UPSTASH_BOX_API_KEY=

# Fine-grained GitHub token. Repository access: the factory repo and every app
# repo. Permissions: Contents, Pull requests and Issues, all read and write.
FACTORY_GITHUB_TOKEN=

# One line per agent sign-in secret named under "auth" in factory.config.json.
# Subscription or API key, whatever that agent type uses. For example:
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=  # for the opencode agent type
